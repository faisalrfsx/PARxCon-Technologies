# PARxCON Ops Environment Configuration Template
# Copy this file to .env and configure for your deployment

# Application Server
PORT=3000
NODE_ENV=production
APP_URL=https://ops.parxcon.com

# PostgreSQL Database (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@localhost:5432/parxcon_ops?schema=public

# Authentication & Cryptography
JWT_SECRET=generate-a-strong-random-32-byte-hex-secret-here
SESSION_SECRET=generate-a-strong-session-secret-here

# Artificial Intelligence (Gemini / OpenAI API)
# In Google AI Studio, GEMINI_API_KEY is injected automatically
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Notification Engine (SMTP Email Dispatcher)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@ops.parxcon.com
SMTP_PASSWORD=your_secure_smtp_password
SMTP_FROM="PARxCON Ops <ops@parxcon.com>"

# Optional Webhook Notification Dispatcher
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
